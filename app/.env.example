# Which cluster the app talks to: "devnet" (default) or "localnet" (a local solana-test-validator).
NEXT_PUBLIC_SOLANA_CLUSTER=devnet

# RPC endpoint. The public devnet RPC is rate-limited and flaky; use a dedicated provider for anything serious.
# Defaults: devnet -> https://api.devnet.solana.com, localnet -> http://127.0.0.1:8899
# NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Websocket endpoint. Derived from the RPC URL on devnet; localnet defaults to ws://127.0.0.1:8900.
# NEXT_PUBLIC_SOLANA_WS_URL=

# --- Server-side only (never prefix these with NEXT_PUBLIC_) ---

# Origina's provider wallet: the registry-approved provider that signs every record. It fronts each record's rent,
# which a connected wallet reimburses in the same transaction; with no wallet connected it pays outright.
# Paste the JSON byte array that `solana-keygen new --outfile origina-provider.json` writes (keep that file out of git).
# In Vercel: Project Settings -> Environment Variables. Without it, anchoring answers "temporarily unavailable".
# ORIGINA_PROVIDER_SECRET_KEY=[12,34,...]

# Optional: a private RPC for the server (falls back to NEXT_PUBLIC_SOLANA_RPC_URL).
# SOLANA_RPC_URL=

# Optional: lamports the provider wallet must keep beyond a record's rent before wallet-less anchoring pauses (default 10000000 = 0.01 SOL).
# ORIGINA_RESERVE_LAMPORTS=
